    "data": {
      "title": "Our Story",
      "body": "Founded in 2018, Café Riverside started as a small pop-up stand and grew into a beloved community gathering spot. We roast our own beans, bake fresh pastries every morning, and source ingredients from local farms within 50 miles. Our riverside patio is the perfect place to enjoy a handcrafted latte while watching the sunset. We're committed to sustainability — all our cups are compostable and we donate day-old goods to local shelters.",
      "image": "/images/cafe-interior.jpg"
    }
